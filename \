#include "parser.h"

char availible[50][1000] = {
    "scanner","-host","-tcp","-udp","-timeout","-first","-last","-maxc"
};

char scan_types[50][1000] = {
    "-tcp","-udp","-syn","-xmas","-null","-fyn"
};

char parsed_command[50][1000];
int ok_input;

int has_command(char* command) {
    for (int i = 0; i < 8; i++) {
        if (strcmp(command, availible[i]) == 0) return 1;
    }
    return 0;
}

struct parsed_input* prepare_result() {
    struct parsed_input *result = malloc(sizeof(struct parsed_input));
    if (result == NULL) {
        perror("malloc");
        return NULL;
    }
    strcpy(result->hostname, "");
    strcpy(result->type_scan, "");
    result->command_type   = DEFAULT_COMMAND;
    result->first          = MIN_PORT;
    result->last           = MAX_PORT;
    result->timeout        = DEFAULT_TIMEOUT;
    result->max_concurrent = DEFAULT_MAX_CONCURRENT;
    return result;
}

int split_command(char command[MAX_CHARACTERS]) {
    char *word = strtok(command, " ");
    int index = 0;
    while (word != NULL && index < 50) {
        strcpy(parsed_command[index], word);
        word = strtok(NULL, " ");
        index++;
    }
    return index;
}

/*
   Format așteptat:
   scanner -host <hostname> [-first <port>] [-last <port>] [-timeout <ms>] [-maxc <n>] [scan_type]
*/
int parse_scan_request(char command[MAX_CHARACTERS], struct parsed_input *res) {
    char already_used[MAX_CHARACTERS];
    char last_arg[1000];

    already_used[0] = '\0';
    last_arg[0] = '\0';

    ok_input = 1;
    res->command_type = 2;

    int words = split_command(command);
    int index = 0;

    if (words == 0) {
        ok_input = 0;
        return ok_input;
    }

    if (strcmp(parsed_command[0], APP_NAME) != 0) {
        ok_input = 0;
        fprintf(stdout, "n-are numele aplicatiei\n");
        return ok_input;
    }

    index++;
    strcpy(last_arg, APP_NAME);
    strcat(already_used, APP_NAME);

    while (index < words) {

        /* Verifică să nu alternezi comenzi/non-comenzi ciudat */
        if ((has_command(parsed_command[index]) == has_command(last_arg)) &&
            strcmp(APP_NAME, last_arg) != 0) {
            ok_input = 0;
            fprintf(stdout, "2 comenzi/noncomenzi la rand: %s %s\n", last_arg, parsed_command[index]);
            break;
        }

        if (has_command(parsed_command[index])) {
            /* E un flag (-host, -first, ...) */

            if (strstr(already_used, parsed_command[index]) != NULL) {
                ok_input = 0;
                fprintf(stdout, "duplicata %s\n", parsed_command[index]);
                return ok_input;
            } else {
                /* marchează flag-ul ca folosit */
                if (already_used[0] != '\0')
                    strcat(already_used, " ");
                strcat(already_used, parsed_command[index]);

                /* verifică dacă e scan type (tcp/udp etc.) */
                for (int i = 0; i < 6; i++) {
                    if (strcmp(parsed_command[index], scan_types[i]) == 0) {
                        if (strcmp(res->type_scan, "") != 0) {
                            ok_input = 0;
                            fprintf(stdout, "2 tipuri de scan %s %s\n",
                                    res->type_scan, parsed_command[index]);
                        } else {
                            /* salvează tipul de scan în result */
                            strncpy(res->type_scan,
                                    parsed_command[index],
                                    sizeof(res->type_scan) - 1);
                            res->type_scan[sizeof(res->type_scan) - 1] = '\0';
                        }
                    }
                }

                strcpy(last_arg, parsed_command[index]);
                index++;
                continue;
            }
        } else {
            /* NU e flag, deci e argument pentru ultimul flag văzut */

            if (strcmp(last_arg, "-host") == 0) {
                strncpy(res->hostname,
                        parsed_command[index],
                        sizeof(res->hostname) - 1);
                res->hostname[sizeof(res->hostname) - 1] = '\0';
            } else if (strcmp(last_arg, "-first") == 0) {
                int len = strlen(parsed_command[index]);
                for (int i = 0; i < len && ok_input; i++) {
                    if (parsed_command[index][i] < '0' ||
                        parsed_command[index][i] > '9') {
                        ok_input = 0;
                    }
                }
                if (!ok_input) {
                    index++;
                    continue;
                }
                int nr = atoi(parsed_command[index]);
                if (nr < MIN_PORT || nr > MAX_PORT)
                    ok_input = 0;
                res->first = nr;
                if (res->first > res->last)
                    ok_input = 0;
            } else if (strcmp(last_arg, "-last") == 0) {
                int len = strlen(parsed_command[index]);
                for (int i = 0; i < len && ok_input; i++) {
                    if (parsed_command[index][i] < '0' ||
                        parsed_command[index][i] > '9') {
                        ok_input = 0;
                    }
                }
                if (!ok_input) {
                    index++;
                    continue;
                }
                int nr = atoi(parsed_command[index]);
                if (nr < MIN_PORT || nr > MAX_PORT)
                    ok_input = 0;
                res->last = nr;
                if (res->first > res->last)
                    ok_input = 0;
            } else if (strcmp(last_arg, "-timeout") == 0) {
                int len = strlen(parsed_command[index]);
                for (int i = 0; i < len && ok_input; i++) {
                    if (parsed_command[index][i] < '0' ||
                        parsed_command[index][i] > '9') {
                        ok_input = 0;
                    }
                }
                if (!ok_input) {
                    index++;
                    continue;
                }
                int nr = atoi(parsed_command[index]);
                if (nr <= 0) ok_input = 0;
                res->timeout = nr;
            } else if (strcmp(last_arg, "-maxc") == 0) {
                int len = strlen(parsed_command[index]);
                for (int i = 0; i < len && ok_input; i++) {
                    if (parsed_command[index][i] < '0' ||
                        parsed_command[index][i] > '9') {
                        ok_input = 0;
                    }
                }
                if (!ok_input) {
                    index++;
                    continue;
                }
                int nr = atoi(parsed_command[index]);
                if (nr <= 0) ok_input = 0;
                res->max_concurrent = nr;
            } else {
                /* argument în loc nepotrivit */
                ok_input = 0;
            }

            strcpy(last_arg, parsed_command[index]);
            index++;
        }
    }

    if (strlen(res->hostname) == 0) {
        fprintf(stdout, "host gol\n");
        ok_input = 0;
    }

    return ok_input;
}

struct parsed_input* parse(char command[MAX_CHARACTERS]) {
    if (strlen(command) == 0) return NULL;

    struct parsed_input *result = prepare_result();
    if (result == NULL) return NULL;

    for (int i = 0; i < (int)strlen(command); i++)
        command[i] = (char)tolower((unsigned char)command[i]);

    if (parse_scan_request(command, result) == 0) {
        free(result);
        return NULL;
    }

    return result;
}

